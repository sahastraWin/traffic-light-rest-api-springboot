{
  "info": {
    "name": "Traffic Light API",
    "_postman_id": "d7a1c9e0-5678-4b2c-8e4f-trafficlight01",
    "description": "Postman collection for the Traffic Light System API (Spring Boot).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/health",
          "host": ["{{base_url}}"],
          "path": ["api", "health"]
        }
      },
      "response": []
    },
    {
      "name": "Get Current State (main)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/traffic-light/state?intersection=main",
          "host": ["{{base_url}}"],
          "path": ["api", "traffic-light", "state"],
          "query": [
            {
              "key": "intersection",
              "value": "main"
            }
          ]
        }
      },
      "response": []
    },
